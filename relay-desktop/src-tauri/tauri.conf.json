{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gens-Relay Server",
  "version": "2.0.0",
  "identifier": "com.williambossard.gens-relay-server",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gens-Relay Server — Administration",
        "width": 1160,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:38421 http://localhost:38421 https://127.0.0.1:38421 https://localhost:38421; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/relay-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
