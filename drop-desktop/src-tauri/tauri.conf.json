{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gens-Drop",
  "version": "2.0.0",
  "identifier": "com.williambossard.gens-drop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gens-Drop",
        "width": 420,
        "height": 580,
        "minWidth": 360,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
