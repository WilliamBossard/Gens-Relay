{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8385/*",
      "https://127.0.0.1:8385/*",
      "http://localhost:8385/*",
      "https://localhost:8385/*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}
