# Configuration Gens-Relay v2 (Go)

# Serveur de coordination (optionnel en LAN pur)
RELAY_LISTEN=:38420
RELAY_URL=ws://127.0.0.1:38420/ws
AUTH_TOKEN=change_me_secret

# Activer le relais aveugle chiffré sur le serveur si le P2P direct échoue hors LAN
ENABLE_BLIND_RELAY=false

# Daemon
NODE_NAME=MonAppareil
GENS_WEB_LISTEN=127.0.0.1:8385
